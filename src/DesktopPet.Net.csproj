<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Modern SDK-style project (.NET 10 LTS, WinForms).
    The legacy .NET Framework projects (DesktopPet_Portable.csproj / DesktopPet.csproj) are kept untouched.
    Build:   dotnet build DesktopPet.Net.csproj -c Release
    Publish: dotnet publish DesktopPet.Net.csproj -c Release -o ..\publish
    Release: ..\Tools\release.ps1 -Version 2.1.0   (version, publish, SHA256SUMS, GitHub release)
    Languages: lang\*.json files are copied next to the exe (not embedded), see Portable\Lang.cs
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DesktopPet</RootNamespace>
    <AssemblyName>DesktopPet</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.net.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <DefineConstants>$(DefineConstants);PORTABLE;NETCORE</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);CS1591;SYSLIB0014;CA1416;WFO1000;WFAC010</NoWarn>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!--
    No NuGet packages: sound uses the Windows MCI API (dotNet\Mp3Player.cs) and JSON uses
    System.Text.Json from the runtime (Portable\JsonText.cs). This keeps the exe around 1 MB.
  -->

  <ItemGroup>
