  <!-- Language files stay outside the exe: anybody can edit them or add a language without recompiling. -->
  <ItemGroup>
    <None Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- …and a copy inside the exe, used when the lang folder is missing (only the exe was downloaded). -->
    <EmbeddedResource Include="lang\*.json" LogicalName="lang/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- "Full" build that needs no .NET installed: dotnet publish -p:SelfContained=true (see Tools\release.ps1). -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <DefineConstants>$(DefineConstants);SELFCONTAINED</DefineConstants>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="dotNet\FormPet.resx" DependentUpon="FormPet.cs" />
    <EmbeddedResource Include="dotNet\FormDebug.resx" DependentUpon="FormDebug.cs" />
    <EmbeddedResource Include="Portable\AboutBox.resx" DependentUpon="AboutBox.cs" />
    <EmbeddedResource Include="Portable\FormHelp.resx" DependentUpon="FormHelp.cs" />
    <EmbeddedResource Include="Portable\FormOptions.resx" DependentUpon="FormOptions.cs" />
    <EmbeddedResource Include="Portable\FormOptions2.resx" DependentUpon="FormOptions2.cs" />
    <EmbeddedResource Include="Portable\Install.resx" DependentUpon="Install.cs" />
    <EmbeddedResource Include="Properties\Resources.resx" />
    <!-- Claude icon on the Integrations card (Portable\FormSettings.Plugins.cs) -->
    <EmbeddedResource Include="Images\claude.png" LogicalName="img/claude.png" />
  </ItemGroup>

</Project>
